---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import {products,categoryNotes} from '../../data/products';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.id},props:{product}}))}
const {product:p}=Astro.props;
const related=products.filter(x=>x.category===p.category&&x.id!==p.id).slice(0,3);
---
<Layout title={`${p.name} — SAMA Insurance`} description={p.description}><div class="wrap breadcrumb"><a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span>{p.name}</div><section class="wrap detail-hero"><div><span class="eyebrow">{p.category.toUpperCase()} / {p.name.toUpperCase()}</span><h1>{p.headline}</h1><p>{p.description}</p><a class="button" href={`/contact/?service=${p.id}`}>Let’s explore {p.name.toLowerCase()} <span>↗</span></a></div><aside class="detail-panel"><span class="product-icon product-icon-large"><Icon name={p.id}/></span><span class="eyebrow">A GOOD PLACE TO START</span><h3>{p.name}</h3><ul>{p.features.map(f=><li>{f}</li>)}</ul><p class="demo-note">A conversation around your needs, before you decide.</p></aside></section><section class="wrap detail-body"><div><span class="eyebrow">YOUR NEXT STEP, MADE CLEARER</span><h2>A little preparation.<br/><em>A better conversation.</em></h2><p>These details can help you make the most of a discussion about {p.name.toLowerCase()}. Start with what you have; there’s no need to share sensitive records in your initial enquiry.</p><div class="notice">{categoryNotes[p.category]}</div></div><div><h3>Helpful to have ready</h3><ul class="checklist">{p.checklist.map(c=><li>{c}</li>)}</ul><div class="notice"><strong>What happens next?</strong><br/>Discuss your priorities, review relevant options and confirm the requirements before choosing how to proceed.</div></div></section><section class="wrap faq"><div><span class="eyebrow">BEFORE YOU BEGIN</span><h2>A few things<br/><em>to know.</em></h2></div><div><details><summary>How do I get started?<span>+</span></summary><p>Choose “Let’s explore” above. Your service will be selected on the enquiry form, where you can describe what you need.</p></details><details><summary>What costs or conditions apply?<span>+</span></summary><p>They depend on the selected provider, product and your circumstances. Ask for the applicable fees, terms and scope before committing.</p></details><details><summary>Can I discuss an existing product or service?<span>+</span></summary><p>Yes. Mention the relevant product and your question. Keep any policy, account or reference numbers private until a suitable secure channel is agreed.</p></details></div></section><section class="wrap related"><span class="eyebrow">KEEP EXPLORING</span><h2>Also worth a look.</h2><div class="product-grid">{related.map(r=><a class="product-card" href={`/products/${r.id}/`}><div class="card-top"><span class="product-icon"><Icon name={r.id}/></span><span class="arrow">↗</span></div><span class="card-category">{r.category}</span><h3>{r.name}</h3><p>{r.headline}</p></a>)}</div></section></Layout>
