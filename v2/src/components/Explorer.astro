---
import Icon from './Icon.astro';
import {products,categories} from '../data/products';
const {compact=false}=Astro.props;
---
<section class:list={['explorer wrap',{'compact':compact}]} id="explore"><div class="section-heading"><div><span class="eyebrow">ONE PARTNER. MANY POSSIBILITIES.</span><h2>What’s your<br/><em>next move?</em></h2></div><p>From your first investment to your next big milestone.<br/>Find the support that fits your life.</p></div><div class="explorer-toolbar"><div class="filters" aria-label="Filter services"><button class="active" data-category="All" aria-pressed="true"><Icon name="All"/>All services <sup>27</sup></button>{categories.map(c=><button data-category={c} aria-pressed="false"><Icon name={c}/>{c}</button>)}</div><label class="search"><Icon name="search"/><input type="search" placeholder="Find a service" aria-label="Search services"/></label></div><p class="results" aria-live="polite">27 services to explore</p><div class="product-grid">{products.map((p)=><a class="product-card" href={`/products/${p.id}/`} data-search={`${p.name} ${p.description}`.toLowerCase()} data-group={p.category}><div class="card-top"><span class="product-icon"><Icon name={p.id}/></span><span class="arrow">↗</span></div><span class="card-category">{p.category}</span><h3>{p.name}</h3><p>{p.headline}</p></a>)}</div><div class="empty" hidden><h3>No services found</h3><p>Try a different search or explore all services.</p><button class="button reset">Clear filters ↗</button></div>{compact&&<div class="center"><a class="text-link" href="/services/">View the complete collection <span>↗</span></a></div>}</section>
<script>
const root=document.querySelector('.explorer');if(root){const input=root.querySelector('input')!;const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-category]')];const cards=[...root.querySelectorAll<HTMLElement>('.product-card')];let category='All';function update(){let n=0;cards.forEach(c=>{const visible=(category==='All'||c.dataset.group===category)&&c.dataset.search!.includes(input.value.toLowerCase().trim());c.hidden=!visible;if(visible)n++});root!.querySelector('.results')!.textContent=`${n} ${n===1?'service':'services'} to explore`;(root!.querySelector('.empty') as HTMLElement).hidden=n>0;buttons.forEach(b=>{const on=b.dataset.category===category;b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on))})}buttons.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;update()}));input.addEventListener('input',update);root.querySelector('.reset')?.addEventListener('click',()=>{category='All';input.value='';update()});const initial=new URLSearchParams(location.search).get('category');if(initial&&buttons.some(b=>b.dataset.category===initial)){category=initial;update()}}
</script>
