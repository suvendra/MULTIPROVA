{
  // Deployment config for static Astro output on Cloudflare Workers static assets.
  // Update "compatibility_date" to the day you deploy if you want a newer one.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samainsurance",
  "compatibility_date": "2026-04-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "workers_dev": false
}