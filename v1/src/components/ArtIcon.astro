---
// Renders a colorful brand icon by name.
// For the 27 product icons, it positions the full sprite sheet /product_icons.png
// without cropping or cutting files.
// Other UI/feature icons fall back to SVG art or local assets.
import { artIcons } from './art-icons';
import { getSpriteInfo } from './product-sprite-coords';

interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className = '', label } = Astro.props;

const sprite = getSpriteInfo(name);

// All real individual icon assets, if present
const assets = import.meta.glob<{ default: string }>('../assets/icons/*.{png,svg,webp,jpg,jpeg}', {
  eager: true,
  query: '?url',
  import: 'default',
});

const asset = Object.entries(assets).find(([file]) =>
  file.split('/').pop()?.startsWith(`${name}.`) ?? file.split('/').pop()?.startsWith(`${name}@`)
)?.[1];

const fallback = artIcons[name] ?? '';
---

{
  sprite ? (
    <span
      class:list={['product-icon-frame', className]}
      role={label ? 'img' : undefined}
      aria-label={label ?? sprite.label}
      aria-hidden={label ? undefined : 'true'}
    >
      <img
        src="/product_icons2.png"
        alt={label ?? sprite.label}
        class="product-icon-sheet"
        style={{
          left: `${sprite.leftPercent}%`,
          top: `${sprite.topPercent}%`,
        }}
        loading="lazy"
        decoding="async"
      />
    </span>
  ) : asset ? (
    <img
      src={asset}
      alt={label ?? name}
      class:list={['art-icon', className]}
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span
      class:list={['art-icon', className]}
      role={label ? 'img' : undefined}
      aria-label={label}
      aria-hidden={label ? undefined : 'true'}
      set:html={fallback}
    />
  )
}

<style>
  .product-icon-frame {
    display: inline-block;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .product-icon-sheet {
    position: absolute;
    width: 900%;
    max-width: none !important;
    height: auto;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
    display: block;
  }
</style>
