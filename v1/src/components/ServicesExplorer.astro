---
import Icon from './Icon.astro';
import ArtIcon from './ArtIcon.astro';
import { everydayServices } from '../data/services';
import { productHref } from '../data/products';
---
<section class="services-section bg-white" id="services" aria-labelledby="services-heading">
  <div class="container-x">
    <div class="services-heading-row">
      <div class="services-heading-copy text-center">
        <p class="text-xs sm:text-sm font-bold tracking-widest text-brand-gold-ink uppercase">EVERYTHING YOU NEED IN ONE PLACE</p>
        <h2 id="services-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-sama-navy sm:text-4xl">Explore our services</h2>
      </div>
      <a href="/services/#everyday-services" class="services-all-link hidden items-center gap-2 rounded-full border border-sama-navy/25 px-5 py-2 text-xs font-semibold text-sama-navy transition hover:bg-slate-50 lg:inline-flex">View all services <Icon name="arrow-right" class="h-4 w-4" /></a>
    </div>
    <div class="service-grid mt-6">
      {everydayServices.map(service => (
        <a href={productHref(service.id)} class="service-card group rounded-2xl border border-slate-100 bg-white text-center shadow-sm transition duration-200 hover:-translate-y-1 hover:border-slate-200 hover:shadow-md">
          <ArtIcon name={service.icon} class="h-12 w-12" />
          <span class="service-name text-sm font-bold text-sama-navy">{service.name}</span>
        </a>
      ))}
    </div>
    <div class="mt-6 text-center lg:hidden"><a href="/services/#everyday-services" class="inline-flex items-center gap-2 text-sm font-semibold text-sama-navy">View all services <Icon name="arrow-right" class="h-4 w-4" /></a></div>
  </div>
</section>
<style>
  .services-section { padding: 24px 0 56px; }
  .service-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .service-card { grid-column: span 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 136px; padding: 16px 12px; }
  .service-card:last-child { grid-column: 2 / span 2; }
  .service-name { display: flex; align-items: center; justify-content: center; min-height: 36px; line-height: 18px; }
  a:focus-visible { outline: 3px solid var(--color-brand-gold-ink); outline-offset: 4px; }
  @media (min-width: 640px) and (max-width: 1023px) {
    .service-grid { grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 16px; }
    .service-card:nth-child(5) { grid-column: 2 / span 2; }
    .service-card:last-child { grid-column: span 2; }
  }
  @media (min-width: 1024px) {
    .services-heading-row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; }
    .services-heading-copy { grid-column: 2; }
    .services-all-link { grid-column: 3; justify-self: end; }
    .service-grid { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 16px; }
    .service-card, .service-card:last-child { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .service-card { transition: none; } .service-card:hover { transform: none; } }
</style>
