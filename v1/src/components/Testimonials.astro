---
import Icon from './Icon.astro';
import { testimonials } from '../data/testimonials';

const shown = testimonials.slice(0, 3);
---
<section class="section bg-[#f8fafc]" id="testimonials">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs sm:text-sm font-bold tracking-widest text-brand-gold-ink uppercase">WHAT OUR CUSTOMERS SAY</p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {shown.map((t) => (
        <figure class="flex flex-col justify-between rounded-2xl border border-slate-100 bg-white p-6 sm:p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-slate-200 hover:shadow-md">
          <div>
            <div class="flex gap-1 text-amber-400" aria-label="Rated 5 out of 5">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" class="h-4 w-4 fill-current" />
              ))}
            </div>
            <blockquote class="mt-4 text-xs sm:text-sm leading-relaxed text-slate-600">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
          </div>
          <figcaption class="mt-5 text-left">
            <strong class="block font-display text-sm font-bold text-sama-navy">&mdash; {t.name}</strong>
            <span class="text-xs text-slate-400">{t.location}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Carousel dots -->
    <div class="mt-8 flex items-center justify-center gap-2" aria-hidden="true">
      <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-sama-navy"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span>
    </div>
  </div>
</section>
