---
import { SITE } from '../config';
interface Props {
  variant?: 'dark' | 'light';
}
const { variant = 'dark' } = Astro.props;
---
<a
  href="/"
  class:list={[
    'inline-flex shrink-0 items-center',
    variant === 'light' && 'rounded bg-white p-1.5',
  ]}
  aria-label={`${SITE.name} — home`}
>
  <img
    src={SITE.logo}
    alt={SITE.name}
    width="784"
    height="300"
    class="block h-auto w-32 sm:w-44"
    loading="eager"
  />
</a>
