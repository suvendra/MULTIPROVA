---
import { SITE } from '../config';
import { insuranceMenuGroups, everydayServices } from '../data/services';
import { productHref } from '../data/products';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const companyLinks = [
  { label: 'Why MULTIPROVA', description: 'What makes our guidance different', href: '/#why-sama' },
  { label: 'How it works', description: 'From enquiry to expert support', href: '/#how-it-works' },
  { label: 'Customer stories', description: 'Hear from people we have helped', href: '/#testimonials' },
  { label: 'FAQs', description: 'Answers to common questions', href: '/#faq' },
];
const menus = ['Insurance', 'Services', 'About'];
---
<header class="site-header sticky top-0 z-50 border-b border-sama-navy/10 bg-white/95 shadow-sm backdrop-blur">
  <div class="container-x flex items-center justify-between gap-2 py-3 sm:gap-4">
    <Logo />
    <nav class="hidden items-center gap-0.5 text-[13.5px] font-medium text-sama-navy lg:flex" aria-label="Primary navigation">
      {menus.map(label => (
        <div class="desktop-menu relative" data-desktop-menu>
          <button type="button" class="nav-trigger inline-flex items-center gap-1 rounded-full px-3 py-2 transition hover:bg-sama-slate focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold-ink/30" aria-expanded="false" aria-controls={`header-${label.toLowerCase()}`}>
            {label}<Icon name="chevron-down" class="h-3.5 w-3.5 opacity-60 transition" />
          </button>
          <div id={`header-${label.toLowerCase()}`} class:list={['desktop-panel absolute top-full z-50 rounded-2xl bg-white p-3 shadow-2xl ring-1 ring-sama-navy/10', label === 'About' ? 'right-0 w-72' : 'left-1/2 w-[560px] -translate-x-1/2']} inert>
            {label === 'Insurance' ? (
              <>
                <div class="grid grid-cols-3 gap-3">
                  {insuranceMenuGroups.map(group => (
                    <div class="min-w-0">
                      <h3 class="px-3 py-2 text-sm font-bold">{group.label}</h3>
                      <div class="border-t border-sama-navy/10 pt-2">
                        {group.items.map(service => <a class="menu-link" href={productHref(service.id)}>{service.name}<Icon name="chevron-right" class="h-3.5 w-3.5 shrink-0 opacity-50" /></a>)}
                      </div>
                    </div>
                  ))}
                </div>
                <a class="menu-all" href="/products/insurance/">Explore insurance<Icon name="arrow-right" class="h-4 w-4" /></a>
              </>
            ) : label === 'Services' ? (
              <>
                <div class="grid grid-cols-2 gap-1">
                  {everydayServices.map(service => <a class="menu-link" href={productHref(service.id)}><span><strong class="block text-sm font-semibold">{service.name}</strong><span class="mt-1 block text-[11px] font-normal leading-relaxed text-sama-navy/55">{service.tagline}</span></span><Icon name="chevron-right" class="h-3.5 w-3.5 shrink-0 opacity-50" /></a>)}
                </div>
                <a class="menu-all" href="/services/#everyday-services">View all services<Icon name="arrow-right" class="h-4 w-4" /></a>
              </>
            ) : companyLinks.map(link => <a class="menu-link" href={link.href}><span><strong class="block text-sm font-semibold">{link.label}</strong><span class="block text-[11px] font-normal text-sama-navy/55">{link.description}</span></span><Icon name="chevron-right" class="h-3.5 w-3.5 shrink-0 opacity-50" /></a>)}
          </div>
        </div>
      ))}
      <a href="/#download-app" class="rounded-full px-3 py-2 transition hover:bg-sama-slate">Get the app</a>
      <a href={SITE.links.partner} class="rounded-full px-3 py-2 transition hover:bg-sama-slate" target="_blank" rel="noopener noreferrer">Become a Partner</a>
    </nav>
    <div class="flex items-center gap-2 sm:gap-3">
      <a href={`tel:${SITE.contact.phone}`} class="hidden h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 transition hover:border-brand-gold-ink xl:inline-flex" aria-label={`Call us on ${SITE.contact.phone}`}><Icon name="phone" class="h-4 w-4" /></a>
      <a href={SITE.links.login} class="btn-gold inline-flex items-center justify-center whitespace-nowrap rounded-full bg-brand-gold px-3 py-2.5 text-xs font-semibold shadow-sm sm:px-5 sm:text-sm">Login</a>
      <button type="button" data-mobile-toggle class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sama-navy text-white lg:hidden" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation"><Icon name="menu" class="h-5 w-5" /></button>
    </div>
  </div>
  <div id="mobile-navigation" class="mobile-panel absolute inset-x-0 top-full max-h-[calc(100dvh-var(--site-header-height))] overflow-y-auto border-b bg-white shadow-xl lg:hidden" inert>
    <nav class="container-x py-4 text-sm text-sama-navy" aria-label="Mobile navigation">
      <a href="/#services" class="mb-2 flex items-center justify-between rounded-xl bg-sama-slate px-4 py-3 font-bold">Explore all services<Icon name="arrow-right" class="h-4 w-4" /></a>
      <details class="mobile-group">
        <summary>Insurance<Icon name="chevron-down" class="h-4 w-4 opacity-60" /></summary>
        <div class="grid grid-cols-3 gap-2 pb-3">
          {insuranceMenuGroups.map(group => <div><h3 class="px-2 py-2 text-sm font-bold">{group.label}</h3>{group.items.map(service => <a href={productHref(service.id)} class="block rounded-xl px-2 py-2.5 text-xs leading-relaxed hover:bg-sama-slate">{service.name}</a>)}</div>)}
        </div>
        <a class="mb-3 block px-4 font-semibold" href="/products/insurance/">Explore insurance →</a>
      </details>
      <details class="mobile-group"><summary>Services<Icon name="chevron-down" class="h-4 w-4 opacity-60" /></summary><div class="grid gap-1 pb-3 sm:grid-cols-2">{everydayServices.map(service => <a href={productHref(service.id)} class="rounded-xl px-4 py-2.5 hover:bg-sama-slate">{service.name}</a>)}</div></details>
      <details class="mobile-group"><summary>About MULTIPROVA<Icon name="chevron-down" class="h-4 w-4 opacity-60" /></summary><div class="grid gap-1 pb-3 sm:grid-cols-2">{companyLinks.map(link => <a href={link.href} class="rounded-xl px-4 py-2.5 hover:bg-sama-slate">{link.label}</a>)}</div></details>
      <div class="mt-3 grid gap-1"><a href="/#download-app" class="rounded-xl px-4 py-3 hover:bg-sama-slate">Get the app</a><a href={SITE.links.partner} class="rounded-xl px-4 py-3 hover:bg-sama-slate" target="_blank" rel="noopener noreferrer">Become a Partner</a></div>
    </nav>
  </div>
</header>
<style>
  .desktop-panel, .mobile-panel { visibility: hidden; opacity: 0; transition: opacity .15s, visibility .15s; }
  .desktop-menu:has(.nav-trigger[aria-expanded='true']) .desktop-panel,
  .site-header:has([data-mobile-toggle][aria-expanded='true']) .mobile-panel { visibility: visible; opacity: 1; }
  .nav-trigger[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .menu-link { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; font-size: 13px; }
  .menu-link:hover { background: var(--color-sama-slate); }
  .menu-all { display: flex; align-items: center; justify-content: center; gap: 8px; border-top: 1px solid var(--color-sama-navy-100); margin-top: 8px; padding: 12px 8px 4px; font-size: 13px; font-weight: 600; }
  .mobile-group { border-bottom: 1px solid var(--color-sama-navy-100); }
  .mobile-group summary { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; cursor: pointer; font-weight: 600; }
  .mobile-group[open] summary :global(svg) { transform: rotate(180deg); }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--color-brand-gold-ink); outline-offset: 3px; }
</style>
<script>
  const desktopMenus = [...document.querySelectorAll<HTMLElement>('[data-desktop-menu]')];
  const setDesktopOpen = (menu: HTMLElement, open: boolean) => {
    menu.querySelector('button')?.setAttribute('aria-expanded', String(open));
    const panel = menu.querySelector<HTMLElement>('.desktop-panel');
    if (panel) panel.inert = !open;
  };
  const closeDesktopMenus = () => desktopMenus.forEach(menu => setDesktopOpen(menu, false));
  desktopMenus.forEach(menu => {
    const button = menu.querySelector<HTMLButtonElement>('button')!;
    button.addEventListener('click', event => {
      const open = event.detail > 0 || button.getAttribute('aria-expanded') !== 'true';
      closeDesktopMenus();
      setDesktopOpen(menu, open);
    });
    menu.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse') return;
      closeDesktopMenus();
      setDesktopOpen(menu, true);
    });
    menu.addEventListener('pointerleave', () => {
      if (!menu.contains(document.activeElement)) setDesktopOpen(menu, false);
    });
    menu.addEventListener('focusout', event => {
      if (!menu.contains(event.relatedTarget as Node)) setDesktopOpen(menu, false);
    });
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape') { setDesktopOpen(menu, false); button.focus(); }
      if (event.key === 'ArrowDown' && event.target === button) {
        event.preventDefault();
        closeDesktopMenus();
        setDesktopOpen(menu, true);
        menu.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
    menu.addEventListener('click', event => {
      if ((event.target as HTMLElement).closest('a')) closeDesktopMenus();
    });
  });
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobilePanel = document.getElementById('mobile-navigation');
  const setMobileOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    if (mobilePanel) mobilePanel.inert = !open;
  };
  toggle?.addEventListener('click', () => setMobileOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  mobilePanel?.addEventListener('click', event => {
    if ((event.target as HTMLElement).closest('a')) setMobileOpen(false);
  });
  document.addEventListener('click', event => {
    const target = event.target as Node;
    desktopMenus.forEach(menu => { if (!menu.contains(target)) setDesktopOpen(menu, false); });
    if (!mobilePanel?.contains(target) && !toggle?.contains(target)) setMobileOpen(false);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setMobileOpen(false); toggle.focus(); }
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', () => { setMobileOpen(false); closeDesktopMenus(); });
</script>
