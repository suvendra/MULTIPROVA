---
import Icon from './Icon.astro';
import ArtIcon from './ArtIcon.astro';
import { faqs } from '../data/faq';
import { SITE } from '../config';
const displayFaqs = faqs.slice(0, 4);
---
<section class="section bg-white" id="faq">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs sm:text-sm font-bold tracking-widest text-brand-gold-ink uppercase">FREQUENTLY ASKED QUESTIONS</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-sama-navy sm:text-4xl">Got questions? We&apos;ve got answers.</h2>
    </div>

    <div class="mt-12 grid items-center gap-8 lg:grid-cols-[1.6fr_1.1fr] lg:gap-12">
      <!-- Accordion -->
      <div class="divide-y divide-slate-200">
        {displayFaqs.map((f, i) => (
          <details class="group py-4.5 transition" open={false}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-sm sm:text-[15px] font-medium text-sama-navy">
              <span>{f.q}</span>
              <span class="text-xl font-light text-slate-400 transition-transform duration-200 group-open:rotate-45 group-open:text-brand-gold-ink">
                +
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm leading-relaxed text-slate-500">{f.a}</p>
          </details>
        ))}
      </div>

      <!-- Still need help card -->
      <div class="flex flex-col items-center justify-center rounded-3xl border border-slate-100 bg-[#f8fafc] p-8 text-center shadow-sm sm:p-10">
        <ArtIcon name="headset-support" class="h-16 w-16" />
        <h3 class="mt-4 font-display text-lg font-bold text-sama-navy">Still need help?</h3>
        <p class="mt-1.5 text-xs sm:text-sm text-slate-500">Our experts are just a call away.</p>
        <a href={`tel:${SITE.contact.phone}`} class="btn-blue mt-6 inline-flex items-center justify-center rounded-full bg-sama-navy px-7 py-3 text-xs sm:text-sm font-semibold text-white shadow-sm transition hover:bg-sama-navy-800">
          Talk to an Expert
        </a>
      </div>
    </div>
  </div>
</section>
