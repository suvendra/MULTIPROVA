---
// MULTIPROVA AI mascot: friendly white robot with a navy face screen and a blue
// "AI" chest badge, waving hello.
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={["sama-mascot relative mx-auto w-fit", { "sama-mascot--compact": compact }]}>
  <!-- Speech bubble -->
  {!compact && <div class="relative z-10 mb-4 ml-auto w-64 animate-floaty rounded-2xl rounded-br-sm bg-white p-4 text-left shadow-xl shadow-sama-navy/10 ring-1 ring-sama-navy/5 sm:w-72">
    <span class="absolute -right-2 top-3 flex h-4 w-4" aria-hidden="true">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
      <span class="relative inline-flex h-4 w-4 rounded-full border-2 border-white bg-emerald-500"></span>
    </span>
    <p class="text-sm leading-snug">
      <strong class="block font-display font-bold text-sama-navy">Hello! I&apos;m MULTIPROVA AI,</strong>
      <span class="text-sama-navy/70">Your smart financial advisor. How can I help you today?</span>
    </p>
  </div>}

  <!-- Robot -->
  <div class="animate-floaty-slow">
    <img src="/sama-robot2.png" width="1326" height="1187" class="robot-image" alt="MULTIPROVA AI robot assistant smiling and waving hello" loading={compact ? 'lazy' : 'eager'} />
  </div>
</div>

<style>
  .sama-mascot { max-width: 100%; }
  .robot-image { display: block; width: 390px; height: 350px; max-width: 100%; object-fit: contain; }
  .sama-mascot:not(.sama-mascot--compact) { mix-blend-mode: multiply; }
  .sama-mascot--compact .robot-image { width: 145px; height: 145px; border-radius: 50%; background: white; object-fit: contain; }
  @media (max-width: 639px) { .robot-image { width: 325px; height: 290px; } }
</style>
