---
import Icon from './Icon.astro';
import ArtIcon from './ArtIcon.astro';
import { featuredProducts } from '../data/featured';
const scroller = 'featured-scroller';
---
<section class="section bg-white" id="featured">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs sm:text-sm font-bold tracking-widest text-brand-gold-ink uppercase">POPULAR PICKS FOR YOU</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-sama-navy sm:text-4xl">Featured products</h2>
    </div>

    <div class="relative mt-10">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 sm:gap-4.5">
        {featuredProducts.map((p) => (
          <article class="flex flex-col items-center justify-between rounded-2xl border border-slate-100 bg-white p-5 text-center shadow-sm transition duration-200 hover:-translate-y-1 hover:border-slate-200 hover:shadow-md sm:p-6">
            <div class="flex flex-col items-center">
              <ArtIcon name={p.icon} class="h-16 w-16" />
              <h3 class="mt-3 font-display text-base font-bold text-sama-navy">{p.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-500">{p.tagline}</p>
            </div>
            <a href="/services/" class="mt-5 inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-blue-600 transition hover:text-blue-700">
              {p.cta} <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </a>
          </article>
        ))}
      </div>

      <!-- Carousel indicator arrow on right edge matching design -->
      <div class="absolute -right-3 top-1/2 hidden -translate-y-1/2 translate-x-1/2 xl:flex">
        <button type="button" class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-400 shadow-md transition hover:border-slate-300 hover:text-sama-navy" aria-label="Next featured products">
          <Icon name="chevron-right" class="h-4 w-4" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-scroll-next]').forEach((b) => {
    b.addEventListener('click', () => document.getElementById(b.dataset.scrollNext!)?.scrollBy({ left: 284, behavior: 'smooth' }));
  });
  document.querySelectorAll('[data-scroll-prev]').forEach((b) => {
    b.addEventListener('click', () => document.getElementById(b.dataset.scrollPrev!)?.scrollBy({ left: -284, behavior: 'smooth' }));
  });
</script>
