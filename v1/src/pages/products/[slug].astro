---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtIcon from '../../components/ArtIcon.astro';
import Icon from '../../components/Icon.astro';
import { products, productHref } from '../../data/products';
import { everydayServices } from '../../data/services';
import { SITE } from '../../config';
export function getStaticPaths() {
  return products.map(product => ({ params: { slug: product.id }, props: { product } }));
}
const { product: p } = Astro.props;
const enquiry = `mailto:${SITE.contact.email}?subject=${encodeURIComponent(`Enquiry: ${p.name}`)}&body=${encodeURIComponent(`Hello MULTIPROVA,\n\nI would like to discuss ${p.name}.\n\nMy question: \nPreferred contact time: \n\nThank you.`)}`;
---
<BaseLayout title={p.name} description={p.intro}>
  <div class="product-page">
    <section class="product-hero">
      <div class="container-x">
        <nav aria-label="Breadcrumb" class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/services/">Products</a><span>/</span><span aria-current="page">{p.name}</span></nav>
        <div class="hero-grid">
          <div>
            <p class="eyebrow">{p.category}</p>
            <h1>{p.headline} <em class="brand-text-gold">{p.highlight}</em></h1>
            <p class="hero-description">{p.intro}</p>
            <div class="hero-actions"><a href="#enquire" class="btn btn-primary">{p.cta}<Icon name="arrow-right" class="h-4 w-4" /></a><a href="#overview" class="text-link">Explore the details <span>↓</span></a></div>
            <p class="hero-caption"><span></span> Real conversations. Clearer decisions.</p>
          </div>
          <div class="visual-stage">
            <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
            <div class="visual-note"><span>✦</span> A little clarity goes a long way.</div>
            <div class="product-visual"><div class="visual-brand">MULTIPROVA <span>WITH YOU, ALL THE WAY</span></div><div class="icon-disc"><ArtIcon name={p.icon} class="h-36 w-36" /></div><h2>{p.visual}</h2><p>{p.visualSub}</p><div class="visual-rule"></div><span class="visual-bottom">{p.name}<span>↗</span></span></div>
            <div class="floating-label"><span class="check-circle">✓</span><div><strong>Start with understanding</strong><small>Choose with confidence</small></div></div>
          </div>
        </div>
        <div class="hero-tags">{p.tags.map((tag, i) => <div><span>0{i + 1}</span>{tag}<Icon name="check" class="h-4 w-4" /></div>)}</div>
      </div>
    </section>
    <nav class="section-nav" aria-label="On this page"><div class="container-x"><a href="#overview">Overview</a><a href="#benefits">How we help</a><a href="#prepare">What to prepare</a><a href="#faqs">FAQs</a><a href="#enquire">Let’s talk ↗</a></div></nav>
    <section id="overview" class="section container-x overview-grid"><div><p class="eyebrow">The bigger picture</p><h2>{p.overview}</h2></div><div><p class="body-copy">{p.description}</p><a href="#enquire" class="text-link">Find your starting point <span>↗</span></a></div></section>
    <section id="benefits" class="benefits-section"><div class="container-x"><p class="eyebrow">Made easier with MULTIPROVA</p><h2>Clarity at every step.</h2><div class="benefit-grid">{p.benefits.map(([title, description], i) => <article><span class="benefit-number">0{i + 1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
    <section id="prepare" class="section container-x prepare-grid"><div><p class="eyebrow">A simple starting point</p><h2>A little preparation.<br />A better conversation.</h2><p class="body-copy">Have these details handy when you speak with us. We’ll help you understand what else may be needed.</p><p class="privacy-note">Keep sensitive documents private. Share them only through a verified channel when requested.</p></div><div class="checklist"><h3>Your conversation checklist</h3>{p.checklist.map((item) => <div class="checklist-item"><span class="check-circle">✓</span><p>{item}</p></div>)}<div class="checklist-footer">Not sure where to start? That’s what we’re here for.</div></div></section>
    <section class="process-section"><div class="container-x"><p class="eyebrow">From questions to next steps</p><h2>Let’s make it simple.</h2><div class="process-grid">{[['Tell us what you need', 'Start with your situation, your questions and what you want to achieve.'], ['Understand your options', 'Talk through the details, requirements and things to consider.'], ['Decide your next step', 'Move forward when you understand the process and feel ready.']].map(([title, text], i) => <div><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></div>)}</div></div></section>
    <section id="faqs" class="section container-x faq-grid"><div><p class="eyebrow">Good questions</p><h2>A little more clarity.</h2><p class="body-copy">Answers to the things you may be wondering.</p></div><div>{p.faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>
    <section id="enquire" class="container-x"><div class="enquiry-panel"><div><p class="eyebrow">Your next step</p><h2>Let’s talk about<br />{p.name}.</h2><p>Bring your questions. We’ll help you find a way forward.</p></div><div class="enquiry-actions"><a class="btn btn-white" href={enquiry}>Email an enquiry <Icon name="arrow-right" class="h-4 w-4" /></a><span>Opens your email app with the product selected.</span><a class="contact-link" href={`tel:${SITE.contact.phone}`}>Or call {SITE.contact.phone}</a></div></div><p class="product-note">{p.note} {p.source && <a href={p.source} target="_blank" rel="noopener noreferrer">{p.sourceLabel} ↗</a>}</p></section>
    <section class="container-x related-section"><div class="related-heading"><h2>Explore a little further.</h2><a href="/services/" class="text-link">All services ↗</a></div><div class="related-grid">{everydayServices.filter(other => other.id !== p.id).map(other => <a href={productHref(other.id)}><ArtIcon name={other.icon} class="h-10 w-10" /><span>{other.name}</span><span>↗</span></a>)}</div></section>
  </div>
</BaseLayout>
<style>
.product-page{--ink:var(--color-sama-navy);--muted:#627087;color:var(--ink)}.product-hero{background:radial-gradient(ellipse at 90% 35%,#dce7f9 0,transparent 55%),#f5f7fc;overflow:hidden}.breadcrumbs{display:flex;gap:12px;flex-wrap:wrap;padding-top:26px;font-size:12px;color:var(--muted)}.breadcrumbs a:hover,.text-link:hover{color:var(--color-brand-gold-ink)}.hero-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:70px;align-items:center;padding:66px 0 72px}h1{font-size:clamp(38px,4.5vw,64px);line-height:1.13;letter-spacing:-2.5px;font-weight:700;margin-top:18px}h1 em{display:block;font-style:normal}.hero-description{font-size:17px;line-height:1.85;color:var(--muted);margin:25px 0 29px;max-width:560px}.hero-actions{display:flex;gap:25px;align-items:center;flex-wrap:wrap}.text-link{font-size:14px;font-weight:600;display:inline-flex;gap:12px;align-items:center}.hero-caption{font-size:12px;color:var(--muted);margin-top:24px;display:flex;align-items:center;gap:8px}.hero-caption>span{width:6px;height:6px;background:#339b79;border-radius:50%}.visual-stage{position:relative;padding:20px 22px 35px}.orbit{position:absolute;border:1px solid #cbd8ed;border-radius:50%;width:440px;height:440px;top:-15px;left:0}.orbit-two{transform:scale(1.2);border-style:dashed;opacity:.6}.product-visual{position:relative;background:#fff;border:1px solid #e0e6f0;border-radius:26px;padding:25px 30px;box-shadow:0 30px 65px #16215c12;transform:rotate(-3deg);text-align:center}.visual-brand{font-size:14px;font-weight:800;text-align:left;letter-spacing:1px;display:flex;align-items:center;justify-content:space-between}.visual-brand>span{font-size:7px;letter-spacing:1px;color:var(--muted)}.icon-disc{width:190px;height:190px;margin:24px auto 18px;background:#f1f5fc;border-radius:50%;display:grid;place-items:center}.product-visual h2{font-size:23px;letter-spacing:-.6px}.product-visual p{font-size:11px;color:var(--muted);margin-top:10px}.visual-rule{height:1px;background:#e8ecf4;margin:25px 0 18px}.visual-bottom{display:flex;justify-content:space-between;font-size:11px;font-weight:600}.visual-bottom>span{color:var(--color-brand-gold-ink)}.visual-note{position:absolute;right:-10px;top:-8px;z-index:2;font-size:10px;background:var(--ink);color:white;border-radius:9px;padding:12px 15px;transform:rotate(5deg)}.visual-note>span{color:#f8b6a2;margin-right:8px}.floating-label{position:absolute;bottom:10px;left:-8px;background:white;border:1px solid #e7edf3;box-shadow:0 10px 35px #16215c10;border-radius:12px;padding:16px 22px;display:flex;gap:12px;align-items:center}.floating-label strong{display:block;font-size:12px}.floating-label small{display:block;font-size:10px;color:var(--muted);margin-top:4px}.check-circle{display:inline-flex;align-items:center;justify-content:center;background:#e8f5f0;color:#267c60;width:30px;height:30px;border-radius:50%;flex-shrink:0}.hero-tags{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #dfe5f0}.hero-tags>div{padding:23px 25px;display:flex;align-items:center;gap:16px;font-size:13px;font-weight:600}.hero-tags>div+div{border-left:1px solid #dfe5f0}.hero-tags span{font-size:10px;color:#8490a8}.hero-tags svg{margin-left:auto;color:#319376}.section-nav{border-bottom:1px solid #e7eaf0;background:white}.section-nav>div{display:flex;gap:36px;overflow-x:auto;white-space:nowrap}.section-nav a{font-size:12px;padding:22px 0;font-weight:600}.section-nav a:last-child{margin-left:auto;color:var(--color-brand-gold-ink)}.section-nav a:hover{color:var(--color-brand-gold-ink)}h2{font-size:clamp(27px,3vw,38px);line-height:1.25;letter-spacing:-1.2px;font-weight:600}.eyebrow{font-size:10px;letter-spacing:2px;margin-bottom:15px}.overview-grid,.prepare-grid,.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:start}.body-copy{font-size:15px;line-height:1.9;color:var(--muted)}.overview-grid .text-link{margin-top:23px}.benefits-section{padding:65px 0;background:#f5f7fb}.benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:30px}.benefit-grid article{padding:30px;background:white;border:1px solid #e7ebf2;border-radius:16px}.benefit-number{display:grid;place-items:center;width:42px;height:42px;background:var(--color-brand-gold-50);border-radius:12px;color:var(--color-brand-gold-ink);font-size:13px;font-weight:600}h3{font-size:17px;font-weight:600;line-height:1.5}.benefit-grid h3{margin:24px 0 11px}.benefit-grid p,.process-grid p{font-size:13px;line-height:1.85;color:var(--muted)}.prepare-grid .body-copy,.faq-grid .body-copy{margin-top:20px}.privacy-note{border-left:2px solid var(--color-brand-gold-ink);padding-left:15px;font-size:11px;line-height:1.8;color:var(--muted);margin-top:25px;max-width:400px}.checklist{border:1px solid #e0e6ee;border-radius:18px;overflow:hidden;box-shadow:0 15px 40px #16215c06}.checklist h3{padding:25px 28px 10px}.checklist-item{display:flex;align-items:center;gap:15px;margin:0 28px;padding:19px 0;border-bottom:1px solid #edf0f5;font-size:13px;line-height:1.7}.checklist-footer{background:#f6f8fc;font-size:11px;padding:19px 28px;color:var(--muted)}.process-section{background:#f5f7fb;padding:65px 0}.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:45px;margin-top:35px}.process-grid>div>span{display:block;color:var(--color-brand-gold-ink);font-size:12px;border-top:1px solid #d6dfed;padding-top:20px;margin-bottom:15px}.process-grid h3{margin-bottom:12px}details{border-bottom:1px solid #e1e7ef;padding:21px 0}details:first-child{padding-top:0}summary{display:flex;justify-content:space-between;gap:24px;cursor:pointer;font-size:14px;font-weight:600;line-height:1.6}summary>span{color:var(--color-brand-gold-ink);font-size:20px}details[open] summary>span{transform:rotate(45deg)}details>p{color:var(--muted);font-size:13px;line-height:1.85;margin-top:15px}.enquiry-panel{background:radial-gradient(ellipse at 95% 100%,#334682,transparent 60%),var(--color-sama-navy);border-radius:24px;padding:48px 55px;color:white;display:flex;justify-content:space-between;gap:35px;align-items:center}.enquiry-panel .eyebrow{color:#f4cc6a}.enquiry-panel p:not(.eyebrow){font-size:13px;color:#c4cee7;margin-top:18px}.enquiry-actions{display:flex;flex-direction:column;align-items:center;gap:14px;flex-shrink:0}.enquiry-actions>span{font-size:10px;color:#c4cee7}.contact-link{font-size:12px;text-decoration:underline;text-underline-offset:4px}.product-note{font-size:11px;line-height:1.8;color:var(--muted);margin-top:22px}.product-note a{text-decoration:underline}.related-section{padding-top:65px;padding-bottom:70px}.related-heading{display:flex;align-items:center;justify-content:space-between;gap:25px}.related-heading h2{font-size:24px}.related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:25px}.related-grid a{border:1px solid #e1e7ef;border-radius:12px;padding:18px;display:flex;align-items:center;gap:12px;font-size:12px;font-weight:600;transition:background .2s}.related-grid a:hover{background:#f0f3fc}.related-grid a>span:last-child{margin-left:auto;color:var(--color-brand-gold-ink)}.product-page :is(a,summary):focus-visible{outline:3px solid var(--color-brand-gold-ink);outline-offset:5px}
@media(max-width:1000px){.hero-grid{gap:25px}.visual-stage{padding-left:12px;padding-right:12px}.visual-note{right:0}.overview-grid,.prepare-grid,.faq-grid{gap:40px}.related-grid{grid-template-columns:repeat(2,1fr)}.enquiry-panel{padding:35px}.visual-brand>span{font-size:6px}}@media(max-width:700px){.hero-grid{grid-template-columns:1fr;padding:40px 0;gap:45px}h1{letter-spacing:-1.5px}.visual-stage{max-width:380px;width:100%;margin:auto}.hero-description{font-size:15px}.hero-tags{grid-template-columns:1fr}.hero-tags>div{padding:16px 0}.hero-tags>div+div{border-left:0;border-top:1px solid #dfe5f0}.section-nav>div{gap:26px}.overview-grid,.prepare-grid,.faq-grid{grid-template-columns:1fr;gap:27px}.benefit-grid,.process-grid{grid-template-columns:1fr;gap:16px}.benefit-grid article{padding:25px}.benefit-grid h3{margin-top:16px}.enquiry-panel{flex-direction:column;align-items:flex-start;padding:30px 24px}.enquiry-actions{align-items:flex-start;flex-shrink:1}.related-grid{grid-template-columns:1fr}.related-heading{align-items:flex-start}.related-heading .text-link{white-space:nowrap;font-size:12px}.related-heading h2{font-size:21px}.orbit{width:330px;height:360px}.hero-actions{gap:20px}}
</style>
