---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesExplorer from '../components/ServicesExplorer.astro';
import Benefits from '../components/Benefits.astro';
import HowItWorks from '../components/HowItWorks.astro';
import AiCtaBanner from '../components/AiCtaBanner.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import AppDownload from '../components/AppDownload.astro';
import PartnerCta from '../components/PartnerCta.astro';
---
<BaseLayout>
  <div class="home-intro">
    <Hero />
    <ServicesExplorer />
    <Benefits />
  </div>
  <HowItWorks />
  <AiCtaBanner />
  <Testimonials />
  <AppDownload />
  <PartnerCta />
  <Faq />
</BaseLayout>

<style>
  .home-intro { --services-overlap: 64px; background: #fff; }
  @media (min-width: 768px) and (max-width: 1023px) {
    .home-intro { --services-overlap: 48px; }
  }
  @media (max-width: 767px) {
    .home-intro { --services-overlap: 32px; }
  }
</style>
