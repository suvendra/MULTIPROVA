---
import Layout from '../layouts/Layout.astro';import {products} from '../data/products';
---
<Layout title="Say hello — Your next move with SAMA"><div class="wrap breadcrumb"><a href="/">Home</a><span>/</span>Let’s talk</div><section class="wrap contact-grid"><div class="contact-copy"><span class="eyebrow">LET’S GET INTO IT</span><h1>Big plans?<br/><em>Say hello.</em></h1><p>A question. An idea. A plan you’re still figuring out. Whatever’s on your mind, this is a good place to start.</p><div class="contact-guide"><span class="guide-spark" aria-hidden="true">✳</span><h3>You bring you.<br/>We’ll bring the questions.</h3><ul><li>Choose a service, or tell us you’re unsure.</li><li>Share your goal in your own words.</li><li>Let us know how you’d prefer to connect.</li></ul></div></div><div><form class="contact-form"><h3>What’s on your mind?</h3><p class="demo-note">Client presentation demo: this form previews the enquiry journey. Nothing is sent or stored.</p><label>Your name<input name="name" autocomplete="name" required maxlength="100" placeholder="Full name"/></label><label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@example.com"/></label><label>I’m interested in<select name="service" id="service"><option value="unsure">I’d like some guidance</option>{products.map(p=><option value={p.id}>{p.name}</option>)}</select></label><label>Preferred way to connect<select name="channel"><option>Email</option><option>Phone call</option><option>WhatsApp</option></select></label><label id="phone-field" hidden>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="Include your country code" pattern="[+0-9 ()-]{7,20}"/></label><label>Tell us a little more <span>(optional)</span><textarea name="message" maxlength="2000" placeholder="What would you like help with? Please don’t include account numbers or sensitive details."></textarea></label><label class="consent"><input type="checkbox" required/> <span>I understand this is a presentation demo and my enquiry will not be sent. <a class="text-link" href="/privacy/">Privacy details</a></span></label><button class="button" type="submit">Preview my enquiry <span>↗</span></button><div class="form-result" role="status" hidden><h3>Your enquiry preview is ready.</h3><p class="summary"></p><p>Nothing has been sent. Live delivery will be enabled once SAMA’s contact channel is confirmed.</p><button class="text-link" type="button" id="edit" style="border:0;background:none;padding:0">Continue editing ↗</button></div></form></div></section></Layout>
<script>
const form=document.querySelector('form')!;const service=form.querySelector<HTMLSelectElement>('[name=service]')!;const id=new URLSearchParams(location.search).get('service');if(id&&[...service.options].some(o=>o.value===id))service.value=id;const channel=form.querySelector<HTMLSelectElement>('[name=channel]')!;channel.addEventListener('change',()=>{const needed=channel.value!=='Email';form.querySelector<HTMLElement>('#phone-field')!.hidden=!needed;form.querySelector<HTMLInputElement>('[name=phone]')!.required=needed});const result=form.querySelector<HTMLElement>('.form-result')!;form.addEventListener('submit',e=>{e.preventDefault();const name=form.querySelector<HTMLInputElement>('[name=name]')!.value;result.querySelector('.summary')!.textContent=`${name}, you’re interested in ${service.selectedOptions[0].text.toLowerCase()} and prefer to connect by ${channel.value.toLowerCase()}.`;result.hidden=false;result.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'nearest'});});form.querySelector('#edit')?.addEventListener('click',()=>{result.hidden=true;form.querySelector<HTMLInputElement>('[name=name]')!.focus()});
</script>
