---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import {products,categoryNotes} from '../../data/products';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.id},props:{product}}))}
const {product:p}=Astro.props;
const related=products.filter(x=>x.category===p.category&&x.id!==p.id).slice(0,3);
---
<Layout title={`${p.name} — Your next move with SAMA`} description={p.description}><div class="wrap breadcrumb"><a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span>{p.name}</div><section class="wrap detail-hero"><div class="detail-intro"><span class="pill"><Icon name={p.category}/>{p.category}</span><h1>{p.headline}</h1><p>{p.description}</p><a class="button" href={`/contact/?service=${p.id}`}>Let’s talk {p.name.toLowerCase()} <span>↗</span></a><p class="detail-micro">Your next move starts with a conversation.</p></div><aside class="detail-panel" data-group={p.category}><div class="panel-top"><span class="product-icon product-icon-large"><Icon name={p.id}/></span><span class="panel-star" aria-hidden="true">✳</span></div><span class="eyebrow">HERE FOR YOUR NEXT CHAPTER</span><h2>{p.name}</h2><ul>{p.features.map(f=><li><span aria-hidden="true">✓</span>{f}</li>)}</ul><span class="panel-foot">BIG PLANS. A LITTLE BACKUP. <b>↗</b></span></aside></section>
<section class="detail-prep"><div class="wrap detail-body"><div><span class="eyebrow">LET’S MAKE IT SIMPLE</span><h2>A little prep.<br/><span>A lot more clarity.</span></h2><p>You don’t need every answer yet. These details are a useful starting point for a conversation about {p.name.toLowerCase()}.</p><p>Keep sensitive records out of your initial enquiry. A suitable way to share documents can be agreed later.</p></div><div class="checklist-panel"><h3>Your starting checklist</h3><ul class="checklist">{p.checklist.map((c,i)=><li><span>{String(i+1).padStart(2,'0')}</span>{c}</li>)}</ul><div class="notice"><strong>Good to know</strong><p>{categoryNotes[p.category]}</p></div></div></div></section>
<section class="wrap detail-next"><span class="eyebrow">THEN WHAT?</span><div class="next-grid">{[['01','Say what’s on your mind.','Start with your goal, a question or something you’d like to understand better.'],['02','Get into the details.','Explore relevant choices and the costs, conditions and requirements involved.'],['03','Make your call.','Choose how to proceed once you’ve reviewed the information that matters to you.']].map(([n,h,t])=><article><span class="next-number">{n}</span><h3>{h}</h3><p>{t}</p></article>)}</div></section>
<section class="wrap faq"><div><span class="eyebrow">THE QUICK ANSWERS</span><h2>Before you<br/><span>make a move.</span></h2></div><div><details><summary>How do I get started?<span>+</span></summary><p>Use the “Let’s talk” button above. This service will be preselected on the enquiry form, ready for you to tell us what you have in mind.</p></details><details><summary>Are there fees or conditions?<span>+</span></summary><p>Costs and conditions depend on the selected provider, product and your circumstances. Ask for the applicable details before committing.</p></details><details><summary>Can I ask about something I already have?<span>+</span></summary><p>Yes. Mention the product and your question. You don’t need to include account numbers, policy numbers or other sensitive information in the first message.</p></details></div></section>
<section class="related"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">KEEP THE POSSIBILITIES COMING</span><h2>Also your <span>kind of thing?</span></h2></div><a class="text-link" href="/services/">Explore everything ↗</a></div><div class="product-grid">{related.map(r=><a class="product-card" href={`/products/${r.id}/`} data-group={r.category}><div class="card-top"><span class="product-icon"><Icon name={r.id}/></span><span class="arrow">↗</span></div><span class="card-category">{r.category}</span><h3>{r.name}</h3><p>{r.headline}</p></a>)}</div></div></section></Layout>
