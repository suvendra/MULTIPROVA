---
import Icon from './Icon.astro';
import {products,categories} from '../data/products';
const {compact=false}=Astro.props;
const visibleIds=['insurance','travel','mutual-fund','education','credit-card','new-vehicle','cibil','wellness'];
const sorted=[...products].sort((a,b)=>{const x=visibleIds.indexOf(a.id),y=visibleIds.indexOf(b.id);return (x<0?99:x)-(y<0?99:y)});
---
<section class:list={['explorer',{'compact':compact}]} id="explore"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">ALL YOUR POSSIBILITIES, IN ONE PLACE</span><h2>Find your <span>thing.</span><sup>27</sup></h2></div><p>For the everyday.<br/>And the anything-but-ordinary.</p></div><div class="explorer-toolbar"><div class="filters" aria-label="Filter services"><button class="active" data-category="All" aria-pressed="true"><Icon name="All"/>All services</button>{categories.map(c=><button data-category={c} aria-pressed="false"><Icon name={c}/>{c}</button>)}</div><label class="search"><Icon name="search"/><input type="search" placeholder="What are you looking for?" aria-label="Search services"/></label></div><p class="results" aria-live="polite">{compact?'8 of 27 services. Find your starting point.':'27 services to explore'}</p><div class="product-grid">{sorted.map((p,i)=><a class="product-card" href={`/products/${p.id}/`} hidden={compact&&i>=8} data-search={`${p.name} ${p.description}`.toLowerCase()} data-group={p.category}><div class="card-top"><span class="product-icon"><Icon name={p.id}/></span><span class="arrow">↗</span></div><span class="card-category">{p.category}</span><h3>{p.name}</h3><p>{p.headline}</p></a>)}</div><div class="empty" hidden><h3>No match just yet.</h3><p>Try a different search, or take a look at everything.</p><button class="button reset">Clear filters ↗</button></div>{compact&&<div class="center"><a class="button outline" href="/services/">Explore all 27 services <span>↗</span></a></div>}</div></section>
<script>
const root=document.querySelector('.explorer');if(root){const input=root.querySelector('input')!;const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-category]')];const cards=[...root.querySelectorAll<HTMLElement>('.product-card')];let category='All';function update(){let n=0;const defaultCompact=root!.classList.contains('compact')&&category==='All'&&!input.value.trim();cards.forEach(c=>{const matches=(category==='All'||c.dataset.group===category)&&c.dataset.search!.includes(input.value.toLowerCase().trim());c.hidden=!matches||(defaultCompact&&n>=8);if(matches)n++});root!.querySelector('.results')!.textContent=defaultCompact?'8 of 27 services. Find your starting point.':`${n} ${n===1?'service':'services'} to explore`;(root!.querySelector('.empty') as HTMLElement).hidden=n>0;buttons.forEach(b=>{const on=b.dataset.category===category;b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on))})}buttons.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;update()}));input.addEventListener('input',update);root.querySelector('.reset')?.addEventListener('click',()=>{category='All';input.value='';update()});const initial=new URLSearchParams(location.search).get('category');if(initial&&buttons.some(b=>b.dataset.category===initial)){category=initial;update()}}
</script>
