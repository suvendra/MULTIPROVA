---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
const {title='SAMA Insurance — Your life. Your move.',description='Big plans deserve a little backup. Explore 27 services for protection, money, mobility and everything next with SAMA Insurance.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#101831"/><title>{title}</title><link rel="icon" href="/logo.png"/></head><body>
<header class="header"><a class="brand" href="/" aria-label="SAMA Insurance home"><img src="/logo.png" alt="SAMA Insurance — Protecting today, securing tomorrow" width="220" height="79"/></a><nav aria-label="Main navigation"><a href="/services/">The good stuff</a><a href="/#approach">Why SAMA?</a><a href="/#questions">Got questions?</a></nav><a class="button small" href="/contact/">Let’s talk <span>↗</span></a><button class="menu" aria-label="Toggle navigation" aria-expanded="false"><span></span><span></span></button></header>
<main><slot/></main><footer class="footer"><div class="wrap footer-top"><div><a class="brand" href="/" aria-label="SAMA home"><img src="/logo.png" alt="SAMA Insurance" width="200" height="72"/></a><p>A little backup.<br/>A lot of life ahead.</p></div><div><span class="eyebrow">FIND YOUR THING</span><a href="/services/?category=Protection">Protect your world</a><a href="/services/?category=Borrowing">Make a big move</a><a href="/services/?category=Wealth">Think future you</a></div><div><span class="eyebrow">KEEP IN TOUCH</span><a href="/contact/">Start a conversation ↗</a><a href="/services/">All 27 services</a><a href="/#approach">Meet the approach</a></div></div><div class="wrap footer-word" aria-hidden="true">GO LIVE <span>A LITTLE.</span>↗</div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} SAMA Insurance</span><span>Protecting today. Securing tomorrow.</span><a href="/privacy/">Privacy</a></div></footer>
<script>const menu=document.querySelector('.menu');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('.header')?.classList.toggle('nav-open',open)});document.querySelectorAll('.header nav a').forEach(a=>a.addEventListener('click',()=>{menu?.setAttribute('aria-expanded','false');document.querySelector('.header')?.classList.remove('nav-open')}));</script>
</body></html>
